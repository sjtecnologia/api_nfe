{% extends 'base.html' %}

{% block title %}Faturamento e Cobrança{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="fas fa-dollar-sign text-success"></i> 
            Faturamento e Cobrança
        </h1>
        <div>
            <a href="{{ url_for('admin.relatorio_gerencial') }}" class="btn btn-info">
                <i class="fas fa-chart-bar"></i> Relatório Gerencial
            </a>
        </div>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endif %}
    {% endwith %}

    <!-- Estatísticas Rápidas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-users"></i> Total Clientes</h5>
                    <h2 class="mb-0">{{ clientes|length }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-check-circle"></i> Configurados</h5>
                    <h2 class="mb-0">{{ clientes|selectattr('config_ativa')|list|length }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-exclamation-triangle"></i> Pendentes Config</h5>
                    <h2 class="mb-0">{{ clientes|rejectattr('config_faturamento_id')|list|length }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-file-invoice"></i> NFes Este Mês</h5>
                    <h2 class="mb-0">{{ clientes|sum(attribute='nfes_mes_atual') }}</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Clientes -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-list"></i> Configurações de Faturamento por Cliente
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>CNPJ</th>
                            <th class="text-center">Valor/NFe</th>
                            <th class="text-center">Forma Pagamento</th>
                            <th class="text-center">Dia Vencimento</th>
                            <th class="text-center">NFes Mês</th>
                            <th class="text-center">Valor Estimado</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cliente in clientes %}
                        <tr>
                            <td>
                                <strong>{{ cliente.razao_social }}</strong>
                                {% if not cliente.config_faturamento_id %}
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="fas fa-exclamation-triangle"></i> Não Configurado
                                </span>
                                {% endif %}
                            </td>
                            <td>{{ cliente.cnpj or '-' }}</td>
                            <td class="text-center">
                                {% if cliente.valor_por_nfe %}
                                    <span class="badge bg-success">R$ {{ "%.2f"|format(cliente.valor_por_nfe) }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if cliente.forma_pagamento %}
                                    {% if cliente.forma_pagamento == 'boleto' %}
                                        <span class="badge bg-secondary"><i class="fas fa-barcode"></i> Boleto</span>
                                    {% elif cliente.forma_pagamento == 'pix' %}
                                        <span class="badge bg-info"><i class="fas fa-qrcode"></i> PIX</span>
                                    {% elif cliente.forma_pagamento == 'cartao_credito' %}
                                        <span class="badge bg-primary"><i class="fas fa-credit-card"></i> Cartão</span>
                                    {% elif cliente.forma_pagamento == 'debito_automatico' %}
                                        <span class="badge bg-success"><i class="fas fa-sync"></i> Débito Auto</span>
                                    {% else %}
                                        <span class="badge bg-dark"><i class="fas fa-money-bill"></i> {{ cliente.forma_pagamento|title }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if cliente.dia_vencimento %}
                                    Dia {{ cliente.dia_vencimento }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info">{{ cliente.nfes_mes_atual or 0 }}</span>
                            </td>
                            <td class="text-center">
                                {% if cliente.valor_estimado_mes > 0 %}
                                    <strong class="text-success">R$ {{ "%.2f"|format(cliente.valor_estimado_mes) }}</strong>
                                {% else %}
                                    <span class="text-muted">R$ 0,00</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if cliente.config_ativa %}
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Ativo</span>
                                {% elif cliente.config_faturamento_id %}
                                    <span class="badge bg-secondary"><i class="fas fa-pause"></i> Inativo</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark"><i class="fas fa-cog"></i> Pendente</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ url_for('admin.edit_faturamento_cliente', cliente_id=cliente.cliente_id) }}" 
                                       class="btn btn-outline-primary" 
                                       title="Editar Configuração">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="{{ url_for('admin.gerar_extrato_cliente', cliente_id=cliente.cliente_id) }}" 
                                       class="btn btn-outline-info" 
                                       title="Gerar Extrato">
                                        <i class="fas fa-file-invoice-dollar"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                Nenhum cliente cadastrado
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Legenda -->
    <div class="mt-3">
        <small class="text-muted">
            <i class="fas fa-info-circle"></i> 
            <strong>Nota:</strong> Os valores são calculados com base nas NFes emitidas no mês atual e na configuração de preço por NFe.
        </small>
    </div>
</div>
{% endblock %}
