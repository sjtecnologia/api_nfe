# Template de Configuração - AWS
# Copie este arquivo para .env e preencha com os valores corretos

# ============================================
# FLASK CONFIGURATION
# ============================================

# Gere uma chave secreta forte (use: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=SUBSTITUIR_POR_CHAVE_SECRETA_FORTE_AQUI

# Ambiente de execução
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
PORT=8080

# ============================================
# DATABASE CONFIGURATION (AWS RDS)
# ============================================

# Formato completo da URL
DATABASE_URL=postgresql://postgres:SENHA_RDS@ENDPOINT_RDS:5432/sjtnfe

# Componentes individuais (para scripts)
DB_HOST=ENDPOINT_RDS_AQUI.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=sjtnfe
DB_USER=postgres
DB_PASSWORD=SENHA_RDS_AQUI

# ============================================
# STORAGE CONFIGURATION
# ============================================

UPLOAD_FOLDER=/home/ubuntu/api_nfe/uploads
BACKUP_DIR=/home/ubuntu/api_nfe/backups
BACKUP_LOG_DIR=/home/ubuntu/api_nfe/logs
BACKUP_RETENTION_DAYS=7

# ============================================
# LOG CONFIGURATION
# ============================================

LOG_LEVEL=INFO

# ============================================
# SEFAZ CONFIGURATION
# ============================================

# True = Homologação, False = Produção
SEFAZ_AMBIENTE_HOMOLOGACAO=True

# True = Usar certificado real, False = Simulado
USAR_CERTIFICADO_REAL=True

# ============================================
# UPLOAD LIMITS
# ============================================

MAX_CONTENT_LENGTH=16777216  # 16MB em bytes

# ============================================
# LLM/IA CONFIGURATION
# ============================================

# URL do servidor Ollama (local na EC2)
LLM_URL=http://localhost:11434/v1/chat/completions

# Modelo a ser usado
LLM_MODEL=codellama:7b-instruct

# Timeout para requisições IA (segundos)
LLM_TIMEOUT=60

# ============================================
# AWS CONFIGURATION (Opcional - para S3)
# ============================================

# AWS_ACCESS_KEY_ID=sua_access_key_aqui
# AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=nome-do-seu-bucket

# ============================================
# OBSERVAÇÕES
# ============================================

# 1. NUNCA commite este arquivo no Git!
# 2. Adicione .env no .gitignore
# 3. Substitua todos os valores MAIÚSCULOS
# 4. Para gerar senha forte: openssl rand -base64 32
# 5. Endpoint RDS: Console AWS > RDS > Databases > seu-banco > Connectivity
